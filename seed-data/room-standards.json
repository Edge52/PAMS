{
  "note": "Room data sheets per room type (wave 14). DRAFT planning figures for review by the biomedical and engineering teams: each value is a typical requirement from UK Health Building Notes (HBN), Health Technical Memoranda (HTM 02-01 medical gases, HTM 03-01 ventilation), the US FGI Guidelines and vendor site-planning guides, rounded for planning. Areas are per bed space when the room has beds, otherwise per room. Confirm against the local code and the makers' guides before design.",
  "rules": [
    { "label": "Cath lab / hybrid theatre", "match": "CATH|ANGIO|HYBRID|INTERVENTION",
      "source": "Cath lab design (ACC 500–600 sq ft); HTM 03-01 theatre ventilation; HTM 02-01 gases",
      "spec": { "minAreaM2": 45, "minCeilingM": 3.0, "minDoorWidthM": 1.4, "floorFinish": "Welded sheet vinyl, coved skirting, antistatic", "wallFinish": "Hygienic cladding, lead lined", "ceilingFinish": "Sealed, cleanable",
        "gases": { "O2": 2, "VAC": 2, "AIR": 1, "AGSS": 1 }, "sockets": 16, "essentialSockets": 12, "powerKva": 100, "dataPoints": 6, "lightingLux": 1000,
        "airChanges": 20, "pressure": "positive", "temperatureC": "18–24", "humidityPct": "35–60", "nurseCall": true, "handWash": false, "leadLined": true,
        "notes": "Scrub sink outside the room. Control room with lead glass window." } },
    { "label": "Operating theatre", "match": "OPERATING|THEATRE|\\bOR\\b|\\bOT\\b",
      "source": "FGI (≥ 37 m² inpatient OR); HBN 26; HTM 03-01 (≥ 25 air changes); HTM 02-01 gases",
      "spec": { "minAreaM2": 37, "minCeilingM": 3.0, "minDoorWidthM": 1.5, "floorFinish": "Welded sheet vinyl, coved skirting, antistatic", "wallFinish": "Hygienic cladding", "ceilingFinish": "Sealed, cleanable",
        "gases": { "O2": 2, "VAC": 2, "AIR": 1, "AIR7": 1, "N2O": 1, "AGSS": 1 }, "sockets": 16, "essentialSockets": 12, "dataPoints": 4, "lightingLux": 1000,
        "airChanges": 25, "pressure": "positive", "temperatureC": "18–25", "humidityPct": "35–60", "nurseCall": true, "handWash": false,
        "notes": "Isolated power (IT) supply for patient circuits. Scrub sink in the scrub room." } },
    { "label": "Isolation room", "match": "ISOLATION|NEGATIVE|AIIR|\\bISO\\b",
      "source": "HBN 04-01 (single room); CDC airborne isolation (≥ 12 air changes, negative)",
      "spec": { "minAreaM2": 16, "minCeilingM": 2.7, "minDoorWidthM": 1.2, "floorFinish": "Welded sheet vinyl, coved", "wallFinish": "Washable paint or cladding", "ceilingFinish": "Sealed, cleanable",
        "gases": { "O2": 1, "VAC": 1, "AIR": 1 }, "sockets": 8, "essentialSockets": 4, "dataPoints": 2, "lightingLux": 300,
        "airChanges": 12, "pressure": "negative", "temperatureC": "20–24", "nurseCall": true, "handWash": true,
