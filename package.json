{
  "name": "hospital-pams",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/seed.ts --reset",
    "demo": "tsx --env-file-if-exists=.env scripts/launch.ts demo",
    "cad:import": "bash tools/cad/import.sh",
    "cad:load": "tsx --env-file-if-exists=.env scripts/load-buildings.ts",
    "reference:sheet": "tsx scripts/reference-sheet.ts",
    "local": "tsx --env-file-if-exists=.env scripts/launch.ts local",
    "backup": "bash scripts/backup.sh",
    "cad:update": "tsx --env-file-if-exists=.env scripts/update-building.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "next": "16.4.3",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.181.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mlightcad/libredwg-web": "^0.8.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "@types/nodemailer": "^8.0.2"
  }
}
