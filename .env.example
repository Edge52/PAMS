# ── Database ──
# PostgreSQL connection for a server install without Docker. Leave it commented out to use the embedded database on
# a laptop (npm run local). The demo (npm run demo) always uses its own embedded database.
# DATABASE_URL=postgres://postgres:your-password@localhost:5432/hpams

# ── Docker / server (docker-compose.yml) ──
# DOMAIN=pams.your-hospital.eg            # the site's address; HTTPS certificates are fetched automatically
# POSTGRES_PASSWORD=change-me-long-random  # letters and digits only (it goes inside a connection URL)
# SETUP_CODE=choose-a-one-time-code       # asked for when creating the first administrator
# BACKUP_KEEP_DAYS=14

# Public address of the app. Printed QR labels and notification emails link here.
# APP_URL=https://pams.your-hospital.eg

# Sign-in cookies are marked Secure when APP_URL is https. Force with 1 (or 0 for plain-http testing).
# COOKIE_SECURE=1

# Behind a reverse proxy (nginx, Caddy, IIS) that sets X-Forwarded-For: set TRUST_PROXY=1 so sign-in throttling sees
# the real client address. Leave it off when the app is reached directly.
# TRUST_PROXY=1

# Time zone for dates such as "today" and due dates (default Africa/Cairo).
# NEXT_PUBLIC_APP_TIME_ZONE=Africa/Cairo

# Where uploaded files are stored (default ./storage/uploads). Use a persistent volume in production.
# UPLOAD_DIR=/var/lib/hospital-pams/uploads

# ── Email notifications (optional; also switch on under Administration › Approval rules & settings) ──
# SMTP_URL=smtps://user:password@smtp.your-provider.com:465
# MAIL_FROM="Hospital PAMS <pams@your-hospital.eg>"
