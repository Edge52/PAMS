# ── Database ──
# PostgreSQL connection for a server install without Docker. Leave it commented out to use the embedded database on
# a laptop (npm run local). The demo (npm run demo) always uses its own embedded database.
# DATABASE_URL=postgres://postgres:your-password@localhost:5432/hpams

# ── Docker / server (docker-compose.yml) ──
# DOMAIN=pams.your-hospital.eg            # the site's address; HTTPS certificates are fetched automatically
# POSTGRES_PASSWORD=change-me-long-random  # letters and digits only (it goes inside a connection URL)
# SETUP_CODE=choose-a-one-time-code       # asked for when creating the first administrator
# Encrypts two-step sign-in secrets in the database. 32+ random characters (e.g. `openssl rand -base64 48`).
# Keep a copy somewhere safe and never change it: without it, everyone must set two-step sign-in up again.
# APP_SECRET=
#   Also required on a server without Docker that uses PostgreSQL: without it, setup stays locked.
# BACKUP_KEEP_DAYS=14
# PostgreSQL client in the app image; must match the database server's major version (16 with docker-compose.yml).
# PG_CLIENT_MAJOR=16

# Public address of the app. Printed QR labels and notification emails link here.
# APP_URL=https://pams.your-hospital.eg

# Sign-in cookies are marked Secure when APP_URL is https. Force with 1 (or 0 for plain-http testing).
# COOKIE_SECURE=1

# Behind a reverse proxy (nginx, Caddy, IIS) that sets X-Forwarded-For: set TRUST_PROXY=1 so sign-in throttling sees
# the real client address. Leave it off when the app is reached directly.
# TRUST_PROXY=1

# Time zone for dates such as "today" and due dates (default Africa/Cairo).
# NEXT_PUBLIC_APP_TIME_ZONE=Africa/Cairo

# Where uploaded files are stored (default ./storage/uploads). Use a persistent volume in production.
# UPLOAD_DIR=/var/lib/hospital-pams/uploads

# ── Email notifications (optional; also switch on under Administration › Approval rules & settings) ──
# SMTP_URL=smtps://user:password@smtp.your-provider.com:465
# MAIL_FROM="Hospital PAMS <pams@your-hospital.eg>"

# Supabase (optional, see docs/deploy.md): database over SSL, and Microsoft / Google sign-in
# DATABASE_SSL=require
# DATABASE_SSL_CA=                        # path to the CA's PEM file (with Docker: a path inside the container)
# DATABASE_POOL_MAX=10
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_PROVIDERS=azure,google
# Microsoft sign-in only for these Entra tenant ids (comma-separated); empty = any tenant.
# SUPABASE_AZURE_TENANTS=

# Assistant (optional; switch it on in Administration › Settings)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Running the server ──
# Hourly alerts run in each app instance; set 1 on a second instance (they are safe to repeat, just wasteful).
# ALERTS_DISABLED=1
# Where Back up now writes (default ./backups; Docker: /data/backups, the nightly job's folder).
# BACKUP_DIR=/var/backups/hospital-pams
# Before new migrations are applied on start, a pg_dump copy is written to BACKUP_DIR. 0 = go on without one.
# MIGRATE_BACKUP=0
# pg_dump / pg_restore when they aren't on the PATH.
# PG_DUMP_PATH=/usr/lib/postgresql/16/bin/pg_dump
# PG_RESTORE_PATH=/usr/lib/postgresql/16/bin/pg_restore
# Port the app listens on (default 3000; Docker sets it).
# PORT=3000
# Nightly backup job (docker-compose.yml): the app container's user, who gets the backup files (0600).
# APP_UID=1000
